@page "/Loom"
@layout LoomLayout

<CascadingValue TValue="Abstractions.Loom" Value="ActiveLoom">
    <div class="loom-grid">
        <div id="loom-setup">
            <Configuration />
        </div>

        <div id="threading">
            Threading
        </div>

        <div id="tieup">
            Tieup
        </div>

        <div id="drawdown">
            Drawdown
        </div>

        <div id="treadling">
            Treadling
        </div>
    </div>
</CascadingValue>

@code {
    [Parameter] public Abstractions.Loom ActiveLoom { get; set; } = new();
}
